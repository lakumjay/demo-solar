    <IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{HTTP_HOST} ^deno\.snwebkarma\.in$ [NC]
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://deno.snwebkarma.in/$1 [L,R=301]

    RewriteRule ^public(?:/|$) - [L]

    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|vendor)(?:/|$) - [F,L,NC]

    RewriteRule ^(.*)$ public/$1 [L]
    </IfModule>

    Options -Indexes